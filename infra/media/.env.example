# ViaRoute media server settings — copy to .env and fill in. Never commit the real file.

# This server's public HTTPS name (A record → this server's IP, DNS only / grey cloud).
MEDIA_DOMAIN=media1.viaroute.co
# This server's public IP: what trunks send SIP and audio to.
EXTERNAL_IP=203.0.113.50

# From ViaRoute → Admin → Carriers → Add carrier → Custom API (shown when you create it):
VIAROUTE_WEBHOOK_URL=https://viaroute.co/api/webhooks/carrier/REPLACE_WITH_CARRIER_ID
VIAROUTE_WEBHOOK_SECRET=whsec_REPLACE
# Make one up (openssl rand -hex 32) and paste it into that carrier's "API key" in ViaRoute.
AGENT_API_KEY=

# Internal: FreeSWITCH ↔ agent (openssl rand -hex 24).
ESL_PASSWORD=

# Optional
SIP_PORT=5060
RTP_START_PORT=16384
RTP_END_PORT=32768
# Upper limit of simultaneous call legs (each live call = 2 legs).
MAX_SESSIONS=4000
SESSIONS_PER_SECOND=100
TTS_VOICE=slt
KEEP_RECORDINGS_HOURS=24
LOG_LEVEL=info
