<?xml version="1.0"?>
<!-- TEST ONLY: plays the SIP trunk (e.g. a Verizon reseller) for the media-server integration test.
     - Sends calls into the media server (the test starts them over the event socket).
     - Answers calls the media server sends out (buyers) with a tone; +12125550000 answers "busy". -->
<document type="freeswitch/xml">
  <X-PRE-PROCESS cmd="set" data="local_ip_v4=172.29.0.20"/>
  <section name="configuration">
    <configuration name="switch.conf"><settings>
      <param name="loglevel" value="warning"/><param name="rtp-start-port" value="20000"/><param name="rtp-end-port" value="20500"/>
    </settings></configuration>
    <configuration name="modules.conf"><modules>
      <load module="mod_console"/><load module="mod_event_socket"/><load module="mod_sofia"/><load module="mod_commands"/>
      <load module="mod_dptools"/><load module="mod_dialplan_xml"/><load module="mod_tone_stream"/><load module="mod_sndfile"/>
    </modules></configuration>
    <configuration name="console.conf"><mappings><map name="all" value="console,debug,info,notice,warning,err,crit,alert"/></mappings>
      <settings><param name="loglevel" value="warning"/></settings></configuration>
    <configuration name="event_socket.conf"><settings>
      <param name="listen-ip" value="0.0.0.0"/><param name="listen-port" value="8021"/><param name="password" value="carrier"/>
      <param name="apply-inbound-acl" value="any"/>
    </settings></configuration>
    <configuration name="acl.conf"><network-lists>
      <list name="any" default="allow"/>
      <list name="media" default="deny"><node type="allow" cidr="172.29.0.10/32"/></list>
    </network-lists></configuration>
    <configuration name="sofia.conf"><global_settings><param name="log-level" value="0"/></global_settings><profiles>
      <profile name="external"><settings>
        <param name="context" value="public"/><param name="dialplan" value="XML"/>
        <param name="sip-ip" value="172.29.0.20"/><param name="rtp-ip" value="172.29.0.20"/><param name="sip-port" value="5060"/>
        <param name="apply-inbound-acl" value="media"/><param name="auth-calls" value="true"/>
        <param name="inbound-codec-prefs" value="PCMU,PCMA"/><param name="outbound-codec-prefs" value="PCMU,PCMA"/>
        <param name="dtmf-type" value="rfc2833"/><param name="rfc2833-pt" value="101"/><param name="disable-register" value="true"/>
      </settings></profile>
    </profiles></configuration>
  </section>
  <section name="dialplan">
    <context name="public">
      <extension name="busy-buyer">
        <condition field="destination_number" expression="^\+?1?2125550000$"><action application="respond" data="486 Busy Here"/></condition>
      </extension>
      <extension name="buyer-answers">
        <condition field="destination_number" expression="^(.+)$">
          <action application="set" data="vr_test_dialled=$1"/>
          <action application="answer"/>
          <action application="endless_playback" data="tone_stream://%(1000,0,620)"/>
        </condition>
      </extension>
    </context>
  </section>
</document>
